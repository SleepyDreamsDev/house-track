# Local dev. In Docker these come from docker-compose.yml.
DATABASE_URL=postgresql://house_track:changeme@127.0.0.1:5432/house_track
POSTGRES_PASSWORD=changeme
LOG_LEVEL=info
TZ=Europe/Chisinau

# Read-only connection for the MCP `run_sql` tool. Uses the house_track_ro role
# (SELECT only) created by scripts/create-ro-role.sql. RO_PASSWORD must match
# the password that role was created with. If DATABASE_URL_RO is unset, run_sql
# reports "not configured" and the other MCP tools still work.
RO_PASSWORD=changeme_ro
DATABASE_URL_RO=postgresql://house_track_ro:changeme_ro@127.0.0.1:5432/house_track

# Optional override of the cron schedule (default: '0 * * * *' — every hour).
# CRON_SCHEDULE=0 * * * *

# Run a single sweep and exit (useful for ad-hoc testing).
# RUN_ONCE=1
