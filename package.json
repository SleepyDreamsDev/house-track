      "nanoid@<3.3.18": ">=3.3.18 <4.0.0",
      "postcss@<=8.5.17": ">=8.5.18 <9.0.0",
      "vitest@<3.2.6": ">=3.2.6 <4.0.0",
      "nanoid@<3.3.12": ">=3.3.12 <4.0.0",
      "qs@>=6.14.2 <=6.15.3": ">=6.16.0 <7.0.0",
      "fast-uri@>=3.0.0 <3.1.6": ">=3.1.6 <4.0.0",
      "fast-uri@>=3.1.2 <3.1.6": ">=3.1.6 <4.0.0",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5.0.0",
      "hono@<4.13.5": ">=4.13.5 <5.0.0",
      "fast-uri@>=3.0.0 <3.1.3": ">=3.1.3 <4.0.0"
    }
  }
}
