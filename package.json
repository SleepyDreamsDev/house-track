{
  "name": "house-track",
  "version": "0.0.0",
  "private": true,
  "description": "999.md house & villa crawler \u2014 POC. Hourly cron, SQLite via Prisma, Chi\u0219in\u0103u + Durle\u0219ti, sale only.",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:start": "node dist/mcp/server.js",
    "capture-session": "tsx scripts/capture-session.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "undici": "^6.21.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.49.0",
    "prettier": "^3.4.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml,prisma}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0 <0.26.0",
      "vite@<=6.4.1": ">=6.4.2 <7.0.0",
      "ip-address@<=10.1.0": ">=10.1.1 <11.0.0",
      "uuid@<11.1.1": ">=11.1.1 <12.0.0",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2 <7.0.0",
      "hono@<4.12.21": ">=4.12.21 <5.0.0",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6 <6.0.0",
      "vite@<=6.4.2": ">=6.4.3 <7.0.0",
      "undici@<6.27.0": ">=6.27.0 <7.0.0",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0 <5.0.0",
      "brace-expansion@<1.1.16": ">=1.1.16 <2.0.0",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0 <5.0.0",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0 <3.0.0",
      "hono@<4.12.25": ">=4.12.25 <5.0.0",
      "hono@>=4.3.3 <4.12.27": ">=4.12.27 <5.0.0",
      "hono@>=4.11.8 <4.12.27": ">=4.12.27 <5.0.0",
      "hono@>=4.0.0 <4.12.27": ">=4.12.27 <5.0.0",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4 <4.0.0",
      "brace-expansion@<1.1.17": ">=1.1.17 <2.0.0",
      "postcss@<=8.5.22": ">=8.5.23 <9.0.0",
      "undici@<6.28.0": ">=6.28.0 <7.0.0",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5 <4.0.0",
      "ip-address@<=10.3.0": ">=10.3.1 <11.0.0",
      "hono@<4.12.34": ">=4.12.34 <5.0.0",
      "brace-expansion@<1.1.18": ">=1.1.18 <2.0.0",
